# Load your private .env into the shell before running; it is not auto-loaded.
DC_TWIN_LLM_API_KEY=
DC_TWIN_LLM_MODEL=
DC_TWIN_LLM_BASE_URL=https://api.openai.com/v1
DC_TWIN_LLM_PROVIDER=openai
# Optional: none, low, medium, high, xhigh, max (provider dependent).
DC_TWIN_LLM_REASONING_EFFORT=medium

# Separate diagnostic judge. This key is never forwarded to Codex automatically.
OPENAI_API_KEY=
DC_TWIN_SEMANTIC_MODEL=gpt-5.6-luna
DC_TWIN_SEMANTIC_BASE_URL=https://api.openai.com/v1
DC_TWIN_SEMANTIC_API_KEY_ENV=OPENAI_API_KEY

# Codex credentials and command; pass CODEX_API_KEY with --codex-env.
CODEX_API_KEY=
DC_BENCH_CODEX_COMMAND=
